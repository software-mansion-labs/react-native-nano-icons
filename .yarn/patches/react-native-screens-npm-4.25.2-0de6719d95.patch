+package com.swmansion.rnscreens.gamma.helpers
+
+import android.content.res.ColorStateList
+import android.graphics.PorterDuff
+import android.graphics.drawable.Drawable
+import androidx.appcompat.graphics.drawable.DrawableWrapperCompat
+
+/**
+ * Drawable wrapper that ignores tinting, so an icon keeps its own (multicolor)
+ * colors even when a host view (e.g. BottomNavigationView) applies an
+ * itemIconTintList. The "original" rendering counterpart to the default
+ * "template" (tinted) icon behavior.
+ */
+internal class NoTintDrawable(
+    drawable: Drawable,
+) : DrawableWrapperCompat(drawable) {
+    override fun setTintList(tint: ColorStateList?) {
+        // no-op: keep original colors
+    }
+
+    override fun setTint(tintColor: Int) {
+        // no-op
+    }
+
+    override fun setTintMode(tintMode: PorterDuff.Mode?) {
+        // no-op
+    }
+}
